# Configurações do App "Onde está o Filme?"

# Ambiente: dev ou prod
APP_ENV=dev

# API Key do TMDB (The Movie Database)
# Obtenha em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_do_tmdb_aqui
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# API Key do Watchmode
# Obtenha em: https://api.watchmode.com/
WATCHMODE_API_KEY=sua_chave_do_watchmode_aqui
WATCHMODE_BASE_URL=https://api.watchmode.com/v1
